# Normalize text files to LF across Windows and Linux CI runners
* text=auto eol=lf

# Explicitly enforce LF on source, config, script, and doc files
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.xml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Keep binary assets untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.woff2 binary